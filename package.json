    "test:presentation": "vitest run services/playgame/presentation components/screens/play/playPresentationArchitecture.test.ts contexts/PlayUiInterleaving.test.tsx",
    "test:engine:regression": "node scripts/playgame/test-engine-regression.mjs",
    "verify:playgame:phase15": "node scripts/playgame/verify-phase15.mjs",
    "test:playgame:manifest": "tsx services/playgame/engine/manifest/manifest.test.ts",
    "test:playgame:phase7": "vitest run components/screens/play/phase7SetupArchitecture.test.ts components/screens/play/playPresentationArchitecture.test.ts services/playgame/debug/debugMatchSetup.test.ts services/playgame/debug/replayPresentation.test.ts services/playgame/engine/manifest/card-set-loader.test.ts services/playgame/engine/manifest/location-set-loader.test.ts",
    "test:architecture": "vitest run routerArchitecture.test.ts contexts/PlayProviders.architecture.test.ts services/playgame/client/matchClient.contract.test.ts services/playgame/testing/authorityTestingArchitecture.test.ts services/playgame/engine/__tests__/legacy-game-retirement-architecture-fences.test.ts services/playgame/engine/__tests__/location-architecture-fences.test.ts services/playgame/engine/__tests__/match-lifecycle-architecture-fences.test.ts services/playgame/engine/__tests__/phase15-architecture-gates.test.ts services/playgame/engine/__tests__/staged-play-architecture-fences.test.ts services/playgame/engine/__tests__/state-api-architecture-fences.test.ts services/playgame/engine/__tests__/superseded-control-paths-architecture-fences.test.ts services/playgame/presentation/cardMotion/architecture.test.ts components/game-surfaces/surfaceArchitecture.test.ts components/screens/play/phase7SetupArchitecture.test.ts components/screens/play/playPresentationArchitecture.test.ts",
    "verify:playgame:phase7": "node scripts/playgame/verify-phase7.mjs",
    "engine:cli": "tsx services/playgame/engine/cli/main.ts",
    "engine:state-size": "tsx scripts/playgame/measure-match-state.ts",
    "cards:generate": "tsx scripts/cards/generate-card-modules.ts",
    "cards:generate:check": "tsx scripts/cards/generate-card-modules.ts --check",
    "locations:generate": "tsx scripts/locations/generate-location-modules.ts",
    "locations:generate:check": "tsx scripts/locations/generate-location-modules.ts --check",
    "protocol:schema:generate": "tsx scripts/protocol/generate-schema.ts",
    "protocol:schema:check": "tsx scripts/protocol/generate-schema.ts --check",
    "protocol:test:ts": "vitest run services/playgame/protocol",
    "protocol:test:rust": "cargo test -p cruel-protocol",
    "ui:mission-v2:generate": "tsx scripts/generate-mission-v2-artifact.ts",
    "ui:mission-v2:generate:check": "tsx scripts/generate-mission-v2-artifact.ts --check",
    "cards:rename": "tsx scripts/cards/rename-card.ts",
    "cards:validate": "tsx services/playgame/engine/manifest/validate-cards.ts",
    "assets:card-backs": "node scripts/card-backs/build.mjs",
    "locations:validate": "tsx services/playgame/engine/manifest/validate-locations.ts"
  },
