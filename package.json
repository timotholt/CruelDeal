{
  "name": "cruel-deal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "asset-foundry": "vite --config vite.asset-foundry.config.ts",
    "asset-foundry:build": "vite build --config vite.asset-foundry.config.ts",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test:playgame:phase0": "PLAYGAME_PROPERTY_CASES=200 vitest run services/playgame/runtime",
    "engine:cli": "tsx services/playgame/engine/cli/main.ts",
    "engine:state-size": "tsx scripts/playgame/measure-match-state.ts",
    "cards:generate": "tsx scripts/cards/generate-card-modules.ts",
    "cards:generate:check": "tsx scripts/cards/generate-card-modules.ts --check",
    "locations:generate": "tsx scripts/locations/generate-location-modules.ts",
    "locations:generate:check": "tsx scripts/locations/generate-location-modules.ts --check",
    "protocol:schema:generate": "tsx scripts/protocol/generate-schema.ts",
    "protocol:schema:check": "tsx scripts/protocol/generate-schema.ts --check",
    "protocol:test:ts": "vitest run services/playgame/protocol",
    "protocol:test:rust": "cargo test -p cruel-protocol",
    "ui:mission-v2:generate": "tsx scripts/generate-mission-v2-artifact.ts",
    "ui:mission-v2:generate:check": "tsx scripts/generate-mission-v2-artifact.ts --check",
    "cards:rename": "tsx scripts/cards/rename-card.ts",
    "cards:validate": "tsx services/playgame/engine/manifest/validate-cards.ts",
    "locations:validate": "tsx services/playgame/engine/manifest/validate-locations.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/unica-one": "^5.2.8",
    "@google/genai": "^1.30.0",
    "@motionone/solid": "^10.16.4",
    "@svgdotjs/svg.js": "^3.2.5",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/solid-query": "^5.99.0",
    "@tanstack/solid-router": "^1.168.20",
    "@tanstack/solid-virtual": "^3.13.24",
    "@timotholt/solid-tree": "git+https://github.com/timotholt/solid-tree.git#3db2ea13aa69bd1b1d3a95c7c531c388619da32c",
    "ajv": "^8.20.0",
    "d3-quadtree": "^3.0.1",
    "dat.gui": "^0.7.9",
    "howler": "2.2.4",
    "interactjs": "^1.10.27",
    "isect": "^3.0.2",
    "jsts": "^2.12.1",
    "loglevel": "^1.9.2",
    "polygon-clipping": "^0.15.7",
    "polyk": "^0.24.0",
    "roughjs": "^4.6.6",
    "simplex-noise": "^2.4.0",
    "simplify-js": "^1.2.4",
    "solid-js": "^1.9.12",
    "tailwindcss": "^4.2.2",
    "three": "^0.184.0",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/dat.gui": "^0.7.13",
    "@types/node": "^22.14.0",
    "@types/three": "^0.184.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.39.4",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.2.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.5"
  }
}
