{
  "status": "playable",
  "poolOrder": 24,
  "implementationNote": "Implemented with owner-scoped location counters.",
  "defId": "debt-alley",
  "version": 1,
  "name": "Debt Alley",
  "rarity": 1,
  "abilities": {
    "onCardPlayedHere": [
      {
        "kind": "CONDITIONAL",
        "if": {
          "kind": "NUM_CMP",
          "a": {
            "kind": "LOCATION_COUNTER",
            "name": "played-here",
            "owner": "EVENT_OWNER"
          },
          "op": "==",
          "b": {
            "kind": "LIT",
            "n": 0
          }
        },
        "then": [
          {
            "kind": "ADD_POWER",
            "target": {
              "kind": "EVENT_CARD"
            },
            "delta": {
              "kind": "LIT",
              "n": -2
            }
          },
          {
            "kind": "MODIFY_LOCATION_COUNTER",
            "lane": {
              "kind": "SELF"
            },
            "name": "played-here",
            "owner": "EVENT_OWNER",
            "delta": {
              "kind": "LIT",
              "n": 1
            }
          }
        ]
      }
    ]
  },
  "cosmetic": {
    "displayName": "DEBT ALLEY",
    "description": "The first card each player plays here gets -2 Power.",
    "accent": "#7f5af0",
    "art": {
      "map": {
        "path": "/art/maps/IcyRoad.png",
        "kind": "image"
      }
    }
  }
}
