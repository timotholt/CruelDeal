{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "App.tsx",
    "index.tsx",
    "router.tsx",
    "components/*.tsx",
    "components/card/**/*.tsx",
    "components/comic/**/*.tsx",
    "components/deck/**/*.tsx",
    "components/game/**/*.tsx",
    "components/history/**/*.tsx",
    "components/inbox/**/*.tsx",
    "components/inspector/**/*.tsx",
    "components/menu/**/*.tsx",
    "components/navigation/**/*.tsx",
    "components/progression/**/*.ts",
    "components/progression/**/*.tsx",
    "components/season/**/*.tsx",
    "components/store/**/*.tsx",
    "components/screens/ClassicPlayScreen.tsx",
    "components/screens/DeckScreen.tsx",
    "components/screens/HistoryScreen.tsx",
    "components/screens/InboxScreen.tsx",
    "components/screens/LadderRankingScreen.tsx",
    "components/screens/LoadingScreen.tsx",
    "components/screens/LoginScreen.tsx",
    "components/screens/MainMenuScreen.tsx",
    "components/screens/ProfileScreen.tsx",
    "components/screens/ProgressionScreen.tsx",
    "components/screens/SeasonScreen.tsx",
    "components/screens/SettingsScreen.tsx",
    "components/screens/StoreScreen.tsx",
    "components/screens/play/*.ts",
    "components/screens/play/*.tsx",
    "components/screens/play/card-faces/**/*.ts",
    "components/screens/play/card-faces/**/*.tsx",
    "contexts/AuthContext.tsx",
    "contexts/MatchSessionContext.tsx",
    "contexts/PlayProviders.tsx",
    "contexts/PlayUiContext.tsx",
    "contexts/UserContext.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "locales/**/*.ts",
    "services/api.ts",
    "services/api/**/*.ts",
    "services/vfx/**/*.ts",
    "services/assetLoader.ts",
    "services/audio.ts",
    "services/fontManager.ts",
    "services/localization.ts",
    "services/playgame/client/**/*.ts",
    "services/playgame/debug/**/*.ts",
    "services/playgame/presentation/**/*.ts",
    "services/playgame/runtime/**/*.ts",
    "services/playgame/view.ts",
    "utils/**/*.ts",
    "cards/**/*.ts",
    "config.ts",
    "constants.ts",
    "types.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/deprecated/**",
    "deprecated/**"
  ]
}
