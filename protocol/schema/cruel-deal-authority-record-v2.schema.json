{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cruel-deal.local/protocol/cruel-deal-authority-record-v2.schema.json",
  "title": "CruelDealAuthorityRecordMessageV2",
  "description": "Trusted authority record boundary for Cruel Deal protocol v2.",
  "$ref": "#/$defs/AuthorityRecordMessage",
  "$defs": {
    "SafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "SafeSignedInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "PositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "EventFrame": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "Seat": {
      "enum": [
        "P0",
        "P1"
      ]
    },
    "ActorSeat": {
      "enum": [
        "P0",
        "P1",
        "SYSTEM"
      ]
    },
    "LaneId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "TimelinePhase": {
      "enum": [
        "SETUP",
        "ACTION",
        "RESOLUTION",
        "END",
        "START",
        "MATCH_END"
      ]
    },
    "PriorityReason": {
      "enum": [
        "MORE_LANES",
        "MORE_POWER",
        "COIN_FLIP",
        "RETAINED"
      ]
    },
    "MatchMode": {
      "enum": [
        "CONQUEST",
        "LADDER",
        "DEBUG"
      ]
    },
    "ParticipantController": {
      "enum": [
        "LOCAL_HUMAN",
        "LOCAL_AI",
        "REMOTE_PLAYER"
      ]
    },
    "TemporalScope": {
      "type": "object",
      "properties": {
        "turn": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "phase": {
          "$ref": "#/$defs/TimelinePhase"
        }
      },
      "required": [
        "turn",
        "phase"
      ],
      "additionalProperties": false
    },
    "MatchResult": {
      "type": "object",
      "properties": {
        "winner": {
          "enum": [
            "P0",
            "P1",
            "DRAW"
          ]
        },
        "lanesWon": {
          "type": "object",
          "properties": {
            "P0": {
              "$ref": "#/$defs/SafeInteger"
            },
            "P1": {
              "$ref": "#/$defs/SafeInteger"
            }
          },
          "required": [
            "P0",
            "P1"
          ],
          "additionalProperties": false
        },
        "totalPower": {
          "type": "object",
          "properties": {
            "P0": {
              "$ref": "#/$defs/SafeSignedInteger"
            },
            "P1": {
              "$ref": "#/$defs/SafeSignedInteger"
            }
          },
          "required": [
            "P0",
            "P1"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "winner",
        "lanesWon",
        "totalPower"
      ],
      "additionalProperties": false
    },
    "TurnResolutionStartedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "TURN_RESOLUTION_STARTED"
        },
        "turn": {
          "$ref": "#/$defs/PositiveInteger"
        }
      },
      "required": [
        "type",
        "turn"
      ],
      "additionalProperties": false
    },
    "TurnStartedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "TURN_STARTED"
        },
        "turn": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "priority": {
          "$ref": "#/$defs/Seat"
        },
        "priorityReason": {
          "$ref": "#/$defs/PriorityReason"
        }
      },
      "required": [
        "type",
        "turn",
        "priority",
        "priorityReason"
      ],
      "additionalProperties": false
    },
    "TurnEndedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "TURN_ENDED"
        },
        "turn": {
          "$ref": "#/$defs/PositiveInteger"
        }
      },
      "required": [
        "type",
        "turn"
      ],
      "additionalProperties": false
    },
    "MatchEndedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "MATCH_ENDED"
        },
        "result": {
          "$ref": "#/$defs/MatchResult"
        }
      },
      "required": [
        "type",
        "result"
      ],
      "additionalProperties": false
    },
    "EffectRef": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "effectKind": {
          "enum": [
            "ON_REVEAL",
            "ONGOING",
            "LOCATION",
            "SYSTEM"
          ]
        },
        "exprIdx": {
          "$ref": "#/$defs/SafeInteger"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceId",
        "effectKind",
        "reason"
      ],
      "additionalProperties": false
    },
    "CardRevealTiming": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "TURN"
            },
            "turn": {
              "$ref": "#/$defs/PositiveInteger"
            }
          },
          "required": [
            "kind",
            "turn"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "END_OF_GAME"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CardStagedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "CARD_STAGED"
        },
        "intentId": {
          "type": "string",
          "minLength": 1
        },
        "cardId": {
          "type": "string",
          "minLength": 1
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "owner": {
          "$ref": "#/$defs/Seat"
        },
        "energyPaid": {
          "$ref": "#/$defs/SafeInteger"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "intentId",
        "cardId",
        "lane",
        "owner",
        "energyPaid",
        "cause"
      ],
      "additionalProperties": false
    },
    "CardRevealScheduledEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "CARD_REVEAL_SCHEDULED"
        },
        "cardId": {
          "type": "string",
          "minLength": 1
        },
        "timing": {
          "$ref": "#/$defs/CardRevealTiming"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "cardId",
        "timing",
        "cause"
      ],
      "additionalProperties": false
    },
    "EffectExpr": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": true
    },
    "LocationCardDeckEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "defId": {
          "type": "string",
          "minLength": 1
        },
        "sourceDeckEntry": {
          "$ref": "#/$defs/SafeInteger"
        }
      },
      "required": [
        "id",
        "defId",
        "sourceDeckEntry"
      ],
      "additionalProperties": false
    },
    "LocationDeckInitializedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_DECK_INITIALIZED"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocationCardDeckEntry"
          },
          "minItems": 1
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "locations",
        "cause"
      ],
      "additionalProperties": false
    },
    "LocationCardCreatedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_CARD_CREATED"
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "defId": {
          "type": "string",
          "minLength": 1
        },
        "pendingLane": {
          "$ref": "#/$defs/LaneId"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "locationId",
        "defId",
        "pendingLane",
        "cause"
      ],
      "additionalProperties": false
    },
    "LocationCardDrawnEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_CARD_DRAWN"
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "pendingLane": {
          "$ref": "#/$defs/LaneId"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "locationId",
        "pendingLane",
        "cause"
      ],
      "additionalProperties": false
    },
    "LocationCardPlayedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_CARD_PLAYED"
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "locationId",
        "lane",
        "cause"
      ],
      "additionalProperties": false
    },
    "LocationSlotRevealScheduledEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_SLOT_REVEAL_SCHEDULED"
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "revealAtTurn": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositiveInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "lane",
        "locationId",
        "revealAtTurn",
        "cause"
      ],
      "additionalProperties": false
    },
    "LocationRevealedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_REVEALED"
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "lane",
        "locationId",
        "cause"
      ],
      "additionalProperties": false
    },
    "LocationTurnedFaceDownEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_TURNED_FACE_DOWN"
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "lane",
        "locationId",
        "cause"
      ],
      "additionalProperties": false
    },
    "LocationShownToSeatsEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_SHOWN_TO_SEATS"
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "seats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Seat"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "lane",
        "locationId",
        "seats",
        "cause"
      ],
      "additionalProperties": false
    },
    "UnscheduledLocationReplacementRevealPolicy": {
      "enum": [
        "REVEAL_IMMEDIATELY",
        "KEEP_SLOT_SCHEDULE",
        "FACE_DOWN_UNSCHEDULED"
      ]
    },
    "ScheduledLocationReplacedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_REPLACED"
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "oldId": {
          "type": "string",
          "minLength": 1
        },
        "newId": {
          "type": "string",
          "minLength": 1
        },
        "newDefId": {
          "type": "string",
          "minLength": 1
        },
        "oldDestination": {
          "enum": [
            "DISCARD",
            "DESTROYED",
            "BANISHED"
          ]
        },
        "revealPolicy": {
          "const": "SCHEDULE_AT_TURN"
        },
        "revealAtTurn": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "lane",
        "oldId",
        "newId",
        "newDefId",
        "oldDestination",
        "revealPolicy",
        "revealAtTurn",
        "cause"
      ],
      "additionalProperties": false
    },
    "UnscheduledLocationReplacedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_REPLACED"
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "oldId": {
          "type": "string",
          "minLength": 1
        },
        "newId": {
          "type": "string",
          "minLength": 1
        },
        "newDefId": {
          "type": "string",
          "minLength": 1
        },
        "oldDestination": {
          "enum": [
            "DISCARD",
            "DESTROYED",
            "BANISHED"
          ]
        },
        "revealPolicy": {
          "$ref": "#/$defs/UnscheduledLocationReplacementRevealPolicy"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "lane",
        "oldId",
        "newId",
        "newDefId",
        "oldDestination",
        "revealPolicy",
        "cause"
      ],
      "additionalProperties": false
    },
    "LocationReplacedEvent": {
      "oneOf": [
        {
          "$ref": "#/$defs/ScheduledLocationReplacedEvent"
        },
        {
          "$ref": "#/$defs/UnscheduledLocationReplacedEvent"
        }
      ]
    },
    "LocationSwapLeg": {
      "type": "object",
      "properties": {
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "fromLane": {
          "$ref": "#/$defs/LaneId"
        },
        "toLane": {
          "$ref": "#/$defs/LaneId"
        }
      },
      "required": [
        "locationId",
        "fromLane",
        "toLane"
      ],
      "additionalProperties": false
    },
    "LocationsSwappedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATIONS_SWAPPED"
        },
        "left": {
          "$ref": "#/$defs/LocationSwapLeg"
        },
        "right": {
          "$ref": "#/$defs/LocationSwapLeg"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "left",
        "right",
        "cause"
      ],
      "additionalProperties": false
    },
    "LocationMovedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_MOVED"
        },
        "fromLane": {
          "$ref": "#/$defs/LaneId"
        },
        "toLane": {
          "$ref": "#/$defs/LaneId"
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "fromLane",
        "toLane",
        "locationId",
        "cause"
      ],
      "additionalProperties": false
    },
    "LocationRemovedFromLaneEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_REMOVED_FROM_LANE"
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "enum": [
            "DISCARD",
            "DESTROYED",
            "BANISHED"
          ]
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "lane",
        "locationId",
        "destination",
        "cause"
      ],
      "additionalProperties": false
    },
    "LocationReturnedToDeckEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LOCATION_RETURNED_TO_DECK"
        },
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "enum": [
            "STAGING",
            "DISCARD",
            "DESTROYED"
          ]
        },
        "placement": {
          "enum": [
            "TOP",
            "BOTTOM"
          ]
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "locationId",
        "from",
        "placement",
        "cause"
      ],
      "additionalProperties": false
    },
    "LaneDestructionStartedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LANE_DESTRUCTION_STARTED"
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "priorPosition": {
          "$ref": "#/$defs/SafeInteger"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "lane",
        "priorPosition",
        "cause"
      ],
      "additionalProperties": false
    },
    "LaneDestroyedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LANE_DESTROYED"
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "priorPosition": {
          "$ref": "#/$defs/SafeInteger"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "lane",
        "priorPosition",
        "cause"
      ],
      "additionalProperties": false
    },
    "LaneCreationStartedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LANE_CREATION_STARTED"
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "position": {
          "$ref": "#/$defs/SafeInteger"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "lane",
        "position",
        "cause"
      ],
      "additionalProperties": false
    },
    "LaneCreatedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "LANE_CREATED"
        },
        "lane": {
          "$ref": "#/$defs/LaneId"
        },
        "position": {
          "$ref": "#/$defs/SafeInteger"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "lane",
        "position",
        "cause"
      ],
      "additionalProperties": false
    },
    "ScheduledPendingEffect": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "SCHEDULED"
        },
        "when": {
          "enum": [
            "START_OF_NEXT_TURN",
            "END_OF_NEXT_TURN"
          ]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceOwner": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seat"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceLane": {
          "anyOf": [
            {
              "$ref": "#/$defs/LaneId"
            },
            {
              "type": "null"
            }
          ]
        },
        "fireTurn": {
          "$ref": "#/$defs/PositiveInteger"
        },
        "effect": {
          "$ref": "#/$defs/EffectExpr"
        },
        "scheduledBy": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "id",
        "kind",
        "when",
        "sourceId",
        "sourceOwner",
        "sourceLane",
        "fireTurn",
        "effect",
        "scheduledBy"
      ],
      "additionalProperties": false
    },
    "PendingEffectScheduledEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "PENDING_EFFECT_SCHEDULED"
        },
        "effect": {
          "$ref": "#/$defs/ScheduledPendingEffect"
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "effect",
        "cause"
      ],
      "additionalProperties": false
    },
    "PendingEffectConsumedEvent": {
      "type": "object",
      "properties": {
        "type": {
          "const": "PENDING_EFFECT_CONSUMED"
        },
        "pendingEffectId": {
          "type": "string",
          "minLength": 1
        },
        "cause": {
          "$ref": "#/$defs/EffectRef"
        }
      },
      "required": [
        "type",
        "pendingEffectId",
        "cause"
      ],
      "additionalProperties": false
    },
    "OtherMatchEvent": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "GAMEPLAY_RNG_ADVANCED",
            "ENERGY_CHANGED",
            "MAX_ENERGY_CHANGED",
            "NEXT_TURN_ENERGY_BONUS_CHANGED",
            "CARD_REVEALED",
            "CARD_PLAY_COMPLETED",
            "OR_WINDOW_OPEN",
